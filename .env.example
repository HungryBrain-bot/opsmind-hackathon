# Default, reproducible judge mode
OPSMIND_PLANNER_PROVIDER=fixture
OPSMIND_TOOL_TRANSPORT=local
OPSMIND_DEMO_STAGE_DELAY_SECONDS=0.8

# Optional OpenAI mode. Prefer passing the key to ./run-ai.sh rather than saving it here.
OPSMIND_OPENAI_API_KEY=
OPSMIND_OPENAI_MODEL=gpt-5.6
OPSMIND_PLANNER_FALLBACK_TO_FIXTURE=true
OPSMIND_PLANNER_PROMPT_VERSION=planner-v1
OPSMIND_PLANNER_MAX_VALIDATION_ATTEMPTS=2

# MCP remains optional for the judge flow.
OPSMIND_MCP_SERVER_COMMAND=python
OPSMIND_MCP_SERVER_MODULE=app.mcp.server

# Keep at zero until current account pricing is explicitly configured.
OPSMIND_MODEL_INPUT_COST_PER_MILLION=0
OPSMIND_MODEL_OUTPUT_COST_PER_MILLION=0
